# ──────────────────────────────────────────────
#  MCP Calculator Server — Environment Variables
# ──────────────────────────────────────────────

# Port the HTTP server will listen on
PORT=3000

# Static API key — clients can use this directly instead of going through OAuth.
# Set to a strong random value in production. Leave empty to disable auth entirely.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=change-me-to-a-strong-random-value

# (Optional) Comma-separated list of allowed CORS origins.
# Use * to allow all origins during development.
ALLOWED_ORIGINS=*
