# ──────────────────────────────────────────────
#  MCP Calculator Server — Environment Variables
# ──────────────────────────────────────────────

# Port the HTTP server will listen on
PORT=3000

# API key clients must send in the X-API-Key header
# Change this to a strong random value in production!
MCP_API_KEY=ABHISHEK
# (Optional) Comma-separated list of allowed origins for CORS
# Use * to allow all origins during development
ALLOWED_ORIGINS=*
